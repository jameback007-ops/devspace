# Install as /etc/devspace/devspace-continuity.env with mode 0600. Keep the
# OAuth owner token in the installed file or a service credential provider; do
# not commit it beside this example.
HOST=127.0.0.1
PORT=7678
DEVSPACE_PUBLIC_BASE_URL=https://continuity.example.invalid
DEVSPACE_ALLOWED_HOSTS=continuity.example.invalid,127.0.0.1,localhost
DEVSPACE_OAUTH_OWNER_TOKEN=replace-with-a-long-random-secret

# The continuity route must have its own state, worktree root, connector
# identity, immutable release, and tool-surface manifest.
DEVSPACE_CONFIG_DIR=/var/lib/devspace-continuity/config
DEVSPACE_STATE_DIR=/var/lib/devspace-continuity/state
DEVSPACE_WORKTREE_ROOT=/var/lib/devspace-continuity-worktrees
DEVSPACE_ALLOWED_ROOTS=/srv/devspace/workspaces,/srv/devspace/src,/srv/zes-codex
DEVSPACE_SKILL_PATHS=/opt/devspace-continuity/current/.agents/skills
DEVSPACE_TOOL_MODE=continuity
DEVSPACE_WIDGETS=off
DEVSPACE_SKILLS=1
DEVSPACE_ARTIFACTS=1

# Mandatory degraded-operational core. The continuity profile rejects startup
# if any of these three capabilities is disabled.
DEVSPACE_EXECUTION_OBSERVABILITY=1
DEVSPACE_EXECUTION_MAILBOX=1
DEVSPACE_TURN_CONTINUITY=1

# Explicitly excluded authority-bearing or broad execution planes. The profile
# rejects startup if any of these are enabled.
DEVSPACE_SUBAGENTS=0
DEVSPACE_ZES_RESEARCH_CYCLE_MODE=off
DEVSPACE_ZES_RESEARCH_INSTRUMENT_EXECUTION_ENABLED=0
DEVSPACE_SELF_REPOSITORY_PUBLICATION=0
DEVSPACE_CONVERSATION_TRANSPORT=0
DEVSPACE_CODEX_INTEGRATION=0

# Pin these values to the exact immutable continuity release after generating
# the deployment manifest. Do not reuse the Nexus epoch or manifest.
DEVSPACE_MCP_SERVER_VERSION=1.0.7-continuity.1
DEVSPACE_TOOL_SURFACE_MANIFEST=/opt/devspace-continuity/current/tool-surface-deployment.json
DEVSPACE_TOOL_SURFACE_MANIFEST_SHA256=replace-with-lowercase-sha256
DEVSPACE_TOOL_SURFACE_SOURCE_COMMIT=replace-with-exact-git-commit
DEVSPACE_TOOL_SURFACE_SOURCE_TREE=replace-with-exact-git-tree
DEVSPACE_TOOL_SURFACE_BUILD_ARTIFACT=/opt/devspace-continuity/current/dist
DEVSPACE_TOOL_SURFACE_EPOCH=continuity:replace-with-release-id

# Logging must not include raw shell commands or credentials.
DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_TOOL_CALLS=1
DEVSPACE_LOG_SHELL_COMMANDS=0
