HOST=127.0.0.1
PORT=7676
# Owner password generated by `devspace init` in ~/.devspace/auth.json. Set this
# only for non-interactive or fully env-driven deployments.
# DEVSPACE_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# DEVSPACE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# DEVSPACE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DEVSPACE_OAUTH_SCOPES=devspace
# DEVSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
DEVSPACE_ALLOWED_ROOTS=/home/waishnav/personal,/home/waishnav/work
# For temporary tunnels, prefer setting this per run. DevSpace derives the
# inbound Host allowlist from this URL.
# DEVSPACE_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# DEVSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
DEVSPACE_TOOL_MODE=full
# Optional in codex mode. Reuses the upstream-native read-only grep, glob, and
# ls handlers without replacing apply_patch, exec_command, or write_stdin.
# DEVSPACE_CODEX_NAVIGATION_TOOLS=1
# off | changes | full. Defaults to changes.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
DEVSPACE_WIDGETS=changes
DEVSPACE_LOG_LEVEL=info
DEVSPACE_LOG_FORMAT=json
DEVSPACE_LOG_REQUESTS=1
DEVSPACE_LOG_ASSETS=0
DEVSPACE_LOG_TOOL_CALLS=1
DEVSPACE_LOG_SHELL_COMMANDS=0
# DEVSPACE_TRUST_PROXY=1
# DEVSPACE_STATE_DIR=/home/waishnav/.local/share/devspace
# DEVSPACE_WORKTREE_ROOT=/home/waishnav/.devspace/worktrees
# Commands inherit a bounded base environment. Add names here only when a
# workspace toolchain needs explicit service-level values. Credentials should
# remain absent unless their command access is an intentional product decision.
# DEVSPACE_COMMAND_ENV_PASSTHROUGH=UV_CACHE_DIR,PANTS_LOCAL_STORE_DIR,PANTS_NAMED_CACHES_DIR,PANTS_PANTSD,PANTS_WATCH_FILESYSTEM
# Optional deployment attestation for the exact model-facing MCP surface. A
# qualified deployment should set all applicable values together and pin the
# manifest digest; partial configuration is reported as INDETERMINATE.
# DEVSPACE_MCP_SERVER_VERSION=1.0.7-zes.2
# DEVSPACE_TOOL_SURFACE_MANIFEST=/etc/devspace/tool-surface-deployment.json
# DEVSPACE_TOOL_SURFACE_MANIFEST_SHA256=<lowercase-sha256>
# DEVSPACE_TOOL_SURFACE_SOURCE_COMMIT=<exact-git-commit>
# DEVSPACE_TOOL_SURFACE_SOURCE_TREE=<exact-git-tree>
# DEVSPACE_TOOL_SURFACE_BUILD_ARTIFACT=/srv/devspace/src/devspace-zesnexus/dist
# DEVSPACE_TOOL_SURFACE_EPOCH=nexus:<deployment-id>
# DEVSPACE_ACCELERATOR_PROFILE=/srv/zes-codex/ZES-SYSTEM-BLUEPRINT/release/repository-execution-accelerator-profile.yaml
# DEVSPACE_ACCELERATOR_PROFILE_REF=git:ZES-SYSTEM-BLUEPRINT@<commit>:release/repository-execution-accelerator-profile.yaml
# Optional JSON array of exact runtime-observed native MCP identities. Do not
# populate this from names or assumed host configuration.
# DEVSPACE_NATIVE_MCP_RUNTIME_IDENTITIES=/etc/devspace/native-mcp-runtime-identities.json
# Optional ZES Research Reflex lifecycle adapter. `observe` exposes the durable
# cycle and records tool-boundary signals without blocking. `enforce` also
# holds ZES source mutation, commit, and publication until one exact native
# Research Reflex v2 admission lease and the matching lifecycle checkpoint are
# current. Generic DevSpace remains unaffected when this is off.
# DEVSPACE_ZES_RESEARCH_CYCLE_MODE=off
# DEVSPACE_ZES_RESEARCH_REPOSITORY_ROOT=/srv/zes-codex/ZES-SYSTEM-BLUEPRINT
# DEVSPACE_ZES_RESEARCH_STATE_ROOT=/var/lib/devspace-zesnexus/zes-research-cycles
# DEVSPACE_ZES_RESEARCH_TIMEOUT_SECONDS=60
# Fixed Research Reflex provider broker handles. Keep these in the DevSpace
# service environment or its secret manager. `zes_research_provider_invoke`
# passes EXA_API_KEY only to the exact Exa child process and never to arbitrary
# exec_command, the model, logs, or the native evidence-binding child.
# EXA_API_KEY=<managed-secret>
# CONTEXT7_API_KEY=<optional-managed-secret>
# Comma-separated roots that may contain exact provider receipts used by
# `zes-research-reflex verify-admission`. The active workspace and the cycle's
# private evidence directory are trusted automatically.
# DEVSPACE_ZES_RESEARCH_TRUSTED_TRACE_ROOTS=/srv/zes-aoq/aoq01-e77671a/state/provider-traces
# Advisory assistant-turn horizon plus Git-bound executor recovery capsules.
# Enabled by default. It never blocks tools, forces a commit, ends a task, or
# authorizes weaker validation. The time values are fallback estimates used
# only when the MCP host supplies no exact devspace/executor-deadline metadata.
# DEVSPACE_TURN_CONTINUITY=1
# DEVSPACE_TURN_HORIZON_MINUTES=120
# DEVSPACE_TURN_HORIZON_AWARENESS_MINUTES=95
# DEVSPACE_TURN_HORIZON_LANDING_MINUTES=110
# DEVSPACE_RECOVERY_CAPSULE_RETENTION_HOURS=720
# DEVSPACE_RECOVERY_CAPSULE_MAX_PER_WORKSPACE=50
# DEVSPACE_RECOVERY_CAPSULE_MAX_CHARACTERS=64000
# Metadata-only cross-session execution observability. Enabled by default and
# stored in the existing owner-only DevSpace SQLite state. It never captures
# transcripts, prompts, private reasoning, tool output, raw commands, patch
# bodies, credentials, or native file handles.
# DEVSPACE_EXECUTION_OBSERVABILITY=1
# DEVSPACE_EXECUTION_OBSERVABILITY_RETENTION_HOURS=168
# DEVSPACE_EXECUTION_OBSERVABILITY_MAX_EVENTS_PER_SCOPE=1000
# DEVSPACE_EXECUTION_OBSERVABILITY_IDLE_MINUTES=5
# Durable target-bound execution-scope mailbox. Enabled by default. Message
# bodies are intentionally persisted for delivery; do not put credentials,
# private reasoning, signed URLs, or unrestricted tool output in them.
# DEVSPACE_EXECUTION_MAILBOX=1
# DEVSPACE_EXECUTION_MAILBOX_DEFAULT_TTL_HOURS=168
# DEVSPACE_EXECUTION_MAILBOX_MAX_TTL_HOURS=720
# DEVSPACE_EXECUTION_MAILBOX_TERMINAL_RETENTION_HOURS=168
# DEVSPACE_EXECUTION_MAILBOX_MAX_PENDING_PER_SCOPE=500
# DEVSPACE_EXECUTION_MAILBOX_MAX_BODY_CHARACTERS=12000
# Durable serialized turns for DevSpace-managed local-agent sessions. These are
# active only when DEVSPACE_SUBAGENTS=1. One worker lease owns provider
# continuation at a time; stale running work becomes indeterminate rather than
# being replayed automatically.
# DEVSPACE_LOCAL_AGENT_MAX_PENDING=200
# DEVSPACE_LOCAL_AGENT_MAX_BODY_CHARACTERS=24000
# DEVSPACE_LOCAL_AGENT_MAX_RESPONSE_CHARACTERS=200000
# DEVSPACE_LOCAL_AGENT_LEASE_SECONDS=120
# DEVSPACE_LOCAL_AGENT_HEARTBEAT_SECONDS=15
# DEVSPACE_LOCAL_AGENT_TERMINAL_RETENTION_HOURS=168
# Local-agent billing is fail-closed by default. subscription_only permits
# only subscription-backed authentication that DevSpace can safely attest and
# rejects known API/BYOK overrides. OpenCode and Pi are disabled in this mode.
# DEVSPACE_LOCAL_AGENT_BILLING_MODE=subscription_only
# Set payg_allowed only when usage-billed credentials are intentional.
# DEVSPACE_LOCAL_AGENT_BILLING_MODE=payg_allowed
# Native-file download is opt-in. Files stream to a model-selected relative
# path inside an already-open workspace without overwriting existing files.
# DEVSPACE_ARTIFACTS=1
# DEVSPACE_ARTIFACT_MAX_FILE_BYTES=104857600
# DEVSPACE_AUTO_LOAD_AGENTS_MD=1
# Skills are enabled by default. Set DEVSPACE_SKILLS=0 to hide them.
# DEVSPACE_SKILLS=0
# DEVSPACE_AGENT_DIR=/home/waishnav/.codex
# DEVSPACE_SKILL_PATHS=/home/waishnav/.codex/skills,/home/waishnav/.claude/skills
