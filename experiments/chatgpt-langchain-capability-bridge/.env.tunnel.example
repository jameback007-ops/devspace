# Do not put tunnel_id or API key values in this repository. Point Compose at a
# root-only env file containing CONTROL_PLANE_TUNNEL_ID and
# CONTROL_PLANE_API_KEY.
TUNNEL_RUNTIME_ENV_FILE=/etc/tunnel-client/zes-agent-runtime.secret.env
TUNNEL_HEALTH_PORT=18080

# Existing standalone bridge inputs.
BRIDGE_WORKSPACE_HOST_PATH=/absolute/path/to/disposable-repository
BRIDGE_PORT=18765
