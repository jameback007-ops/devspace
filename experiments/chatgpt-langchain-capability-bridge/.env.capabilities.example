# Optional native capability planes. This file contains no credentials.

# Dedicated Agent Server hosting this bridge. Leave empty in standalone mode.
BRIDGE_AGENT_SERVER_URL=http://agent-server:2024
BRIDGE_AGENT_SERVER_SELF=false
BRIDGE_AGENT_SERVER_ASSISTANT_IDS=bridge_journal,bridge_hitl
BRIDGE_AGENT_SERVER_WORKSTREAM_GRAPH_ID=bridge_journal
BRIDGE_AGENT_SERVER_WORKSTREAM_METADATA_KEY=bridge_workstream_ref
BRIDGE_AGENT_SERVER_STORE_PREFIX=chatgpt-langchain-bridge
BRIDGE_AGENT_SERVER_THREAD_METADATA_KEY=chatgpt_langchain_bridge
BRIDGE_AGENT_SERVER_THREAD_METADATA_VALUE=v2
BRIDGE_AGENT_SERVER_REQUEST_TIMEOUT_SECONDS=60

# Optional alias -> allowlisted assistant ID mapping. Empty means no specialist
# can be invoked.
BRIDGE_SPECIALIST_ASSISTANTS={}

# Native sandbox provider selection. The current LangSmith organization did not
# have Sandbox enabled during qualification, so leave this empty for Gate A.
BRIDGE_SANDBOX_PROVIDER=
BRIDGE_SANDBOX_WORKSPACE_ROOT=/workspace
BRIDGE_SANDBOX_NAME_PREFIX=zes-chatgpt-bridge-
BRIDGE_SANDBOX_SNAPSHOT_IDS=
BRIDGE_SANDBOX_SNAPSHOT_NAMES=

# Native skill roots, resolved inside each selected workspace.
BRIDGE_SKILL_SOURCE_DIRS=.agents/skills:.deepagents/skills:.claude/skills:skills
