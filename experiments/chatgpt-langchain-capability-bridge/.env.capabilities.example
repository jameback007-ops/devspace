# Optional native capability planes. This file contains no credentials.

# Dedicated Agent Server hosting this bridge. Leave empty in standalone mode.
BRIDGE_AGENT_SERVER_URL=http://agent-server:2024
BRIDGE_AGENT_SERVER_SELF=false
BRIDGE_AGENT_SERVER_ASSISTANT_IDS=bridge_journal,bridge_hitl,bridge_interaction,bridge_material_operation
BRIDGE_AGENT_SERVER_WORKSTREAM_GRAPH_ID=bridge_journal
BRIDGE_AGENT_SERVER_WORKSTREAM_METADATA_KEY=bridge_workstream_ref
BRIDGE_AGENT_SERVER_STORE_PREFIX=chatgpt-langchain-bridge
BRIDGE_AGENT_SERVER_THREAD_METADATA_KEY=chatgpt_langchain_bridge
BRIDGE_AGENT_SERVER_THREAD_METADATA_VALUE=v2
BRIDGE_AGENT_SERVER_INTERACTION_GRAPH_ID=bridge_interaction
BRIDGE_AGENT_SERVER_THREAD_ROLE_METADATA_KEY=bridge_thread_role
BRIDGE_AGENT_SERVER_REQUEST_TIMEOUT_SECONDS=60
BRIDGE_DURABLE_MATERIAL_OPERATIONS=false
BRIDGE_MATERIAL_OPERATION_ASSISTANT_ID=bridge_material_operation

# Optional alias -> allowlisted assistant ID mapping. Empty means no specialist
# can be invoked.
BRIDGE_SPECIALIST_ASSISTANTS={}

# Allowlisted external A2A peers. The MCP tool accepts aliases only; model-
# supplied URLs are rejected. Agent Server peers can use an assistant-specific
# card path such as /a2a/<assistant-uuid>/.well-known/agent-card.json.
# Example shape:
# {"peer":{"participant_ref":"peer/runtime","transport":"a2a", \
# "capability_refs":["code.review"],"adapter_config":{ \
# "base_url":"https://peer", \
# "agent_card_path":"/.well-known/agent-card.json", \
# "protocol_mode":"strict-v1"}}}
# Use protocol_mode=legacy-v0.3 only for an explicitly qualified compatibility
# endpoint whose advertised v1 card still emits the older kind-tagged wire form.
BRIDGE_A2A_ENDPOINTS={}

# Native sandbox provider selection. The current LangSmith organization did not
# have Sandbox enabled during qualification, so leave this empty for Gate A.
BRIDGE_SANDBOX_PROVIDER=
BRIDGE_SANDBOX_WORKSPACE_ROOT=/workspace
BRIDGE_SANDBOX_NAME_PREFIX=zes-chatgpt-bridge-
BRIDGE_SANDBOX_SNAPSHOT_IDS=
BRIDGE_SANDBOX_SNAPSHOT_NAMES=

# Native skill roots, resolved inside each selected workspace.
BRIDGE_SKILL_SOURCE_DIRS=.agents/skills:.deepagents/skills:.claude/skills:skills

# Optional native Git worktree catalog. workspace_open keeps its frozen schema:
# pass path="zes-worktree://<alias>" plus an explicit thread_id/workstream ref.
# Agent Server Store owns the durable workstream binding; Git owns worktree and
# branch state. Prefer BRIDGE_WORKTREE_CATALOG_FILE for a deployed runtime.
BRIDGE_WORKTREE_CATALOG_FILE=
BRIDGE_WORKTREE_CATALOG_JSON=
BRIDGE_WORKTREE_LOCK_ROOT=/run/zes-worktree-bindings
