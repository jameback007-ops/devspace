# Copy this file outside the repository to a root-owned 0600 runtime env file.
# Do not put real values in the tracked project tree.

# Required by the licensed standalone Agent Server runtime.
LANGGRAPH_CLOUD_LICENSE_KEY=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
DATABASE_URI=
REDIS_URI=

# Recommended before durable production data is admitted. The runtime accepts
# 16, 24, or 32 bytes; choose and retain one key through the data lifetime.
LANGGRAPH_AES_KEY=

# Keep the API private. The actual Docker host-port binding must be loopback
# only in the root-owned deployment overlay used at activation time.
LANGGRAPH_SERVER_HOST=0.0.0.0
PORT=8000

# Existing application settings remain non-secret and may be loaded from the
# tracked .env.agent-server file as a separate env_file.
